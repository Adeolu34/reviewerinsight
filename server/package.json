{
  "name": "reviewer-insight-server",
  "version": "1.0.0",
  "description": "AI-powered book review agent system for Reviewer Insight",
  "main": "src/index.js",
  "scripts": {
    "start": "node init && node src/index.js",
    "dev": "node init && node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "agent": "node scripts/runAgent.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/api.test.js",
    "lint": "eslint src scripts test --quiet"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "googleapis": "^171.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "node-cron": "^4.6.0",
    "openai": "^4.77.0",
    "winston": "^3.17.0"
  },
  "overrides": {
    "qs": "^6.16.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
