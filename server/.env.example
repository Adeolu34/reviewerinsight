PORT=3001
MONGODB_URI=mongodb://localhost:27017/reviewer-insight
# Canonical site origin for sitemap / absolute URLs (no trailing slash)
PUBLIC_SITE_URL=https://reviewerinsight.com

# LLM: prefer OpenRouter + cheap Claude (default anthropic/claude-3-haiku). If OPENROUTER_API_KEY is set, it wins over OpenAI.

OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_BOOKS_API_KEY=your-google-books-key-here
NYT_BOOKS_API_KEY=your-nyt-api-key-here
ADMIN_API_KEY=your-admin-key-here
JWT_SECRET=your-jwt-secret-here
# First admin user (only used when AdminUser collection is empty)
ADMIN_INITIAL_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=choose-a-strong-password
ADMIN_INITIAL_NAME=Admin
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_DAILY_BUDGET_USD=10.00
NODE_ENV=development

# ── Video Generation ─────────────────────────────────────────────
# ElevenLabs TTS — get key at https://elevenlabs.io (free: 10k chars/month)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Voice ID (default: Rachel — warm narration voice). Get IDs from /v1/voices
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here
# Where to save generated MP3s and MP4s (defaults to /videos in repo root)
VIDEO_OUTPUT_DIR=/var/data/reviewinsight/videos

# ── Book YouTube (VOD uploads) ───────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_REDIRECT_URI=https://your-domain.com/api/admin/youtube/callback

# ── Nature Live 24/7 (separate YouTube channel — use different Google account at OAuth) ──
# Same YOUTUBE_CLIENT_ID/SECRET; add redirect URI: .../api/admin/nature-live/youtube/callback
NATURE_YOUTUBE_REFRESH_TOKEN=
# If unset, uses PUBLIC_SITE_URL + /api/admin/nature-live/youtube/callback (or derives from YOUTUBE_REDIRECT_URI)
NATURE_YOUTUBE_REDIRECT_URI=https://reviewerinsight.com/api/admin/nature-live/youtube/callback
NATURE_YOUTUBE_PRIVACY=public
NATURE_LIVE_DIR=/var/data/reviewinsight/nature-live
# Video: try providers in order (free stock). Keys at pexels.com/api and pixabay.com/api/docs/
NATURE_VIDEO_PROVIDERS=pexels,pixabay
PEXELS_API_KEY=your-pexels-api-key-here
PIXABAY_API_KEY=your-pixabay-api-key-here
# Audio: auto = ElevenLabs SFX (same ELEVENLABS_API_KEY as book videos) → Freesound → ffmpeg noise
NATURE_AUDIO_PROVIDER=auto
# NATURE_ELEVENLABS_LOOP=true
# NATURE_ELEVENLABS_INFLUENCE=0.65
# Freesound: use "Client secret/Api key" from https://freesound.org/apiv2/apply (NOT Client ID)
FREESOUND_API_KEY=your-freesound-api-key-here
# FREESOUND_CLIENT_SECRET=   # same value as FREESOUND_API_KEY if you prefer that name
# FREESOUND_CLIENT_ID=       # only needed for OAuth2 user login (not required for Nature Live previews)
# Resume encoders after deploy if DB status is live
NATURE_LIVE_AUTO_RESUME=false
NATURE_WATCHDOG_INTERVAL_MS=60000
# Encoder tuning (7 streams need ~4–8 vCPU + strong upload bandwidth)
NATURE_FFMPEG_PRESET=veryfast
NATURE_VIDEO_BITRATE=2500k
NATURE_STREAM_RESOLUTION=1920:1080
# FFMPEG_PATH=ffmpeg
